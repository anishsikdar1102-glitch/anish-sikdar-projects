      "source": [
        "import pandas as pd\n",
        "from transformers import pipeline\n",
        "\n",
        "# Load your dataset\n",
        "df = pd.read_csv(\"sentiment.csv.csv\")\n",
        "\n",
        "# Create the sentiment analyzer\n",
        "analyzer = pipeline(\"sentiment-analysis\")\n",
        "\n",
        "# Analyze each row in the \"text\" column\n",
        "df[\"sentiment\"] = df[\"text\"].fillna(\"\").astype(str).apply(\n",
        "    lambda text: analyzer(text[:512])[0][\"label\"] if text.strip() else \"\"\n",
        ")\n",
        "\n",
        "# Save results\n",
        "df.to_csv(\"sentiment_results.csv\", index=False)\n",
        "\n",
        "print(df[[\"text\", \"sentiment\"]].head())"
      ]
