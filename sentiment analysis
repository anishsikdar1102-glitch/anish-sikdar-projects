      "source": [
        "from sklearn.metrics import confusion_matrix, classification_report\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Define the mapping from original emotions to POSITIVE/NEGATIVE/NEUTRAL\n",
        "emotion_to_three_classes = {\n",
        "    'sadness': 'NEGATIVE',\n",
        "    'anger': 'NEGATIVE',\n",
        "    'fear': 'NEGATIVE',\n",
        "    'disgust': 'NEGATIVE',\n",
        "    'shame': 'NEGATIVE',\n",
        "    'guilt': 'NEGATIVE',\n",
        "    'joy': 'POSITIVE',\n",
        "    'love': 'POSITIVE',\n",
        "    'surprise': 'POSITIVE',\n",
        "    'neutral': 'NEUTRAL'\n",
        "}\n",
        "\n",
        "# Map the original sentiment emotions\n",
        "df_vader['actual_sentiment_mapped'] = df_vader['sentiment'].str.lower().str.strip().map(emotion_to_three_classes)\n",
        "\n",
        "# Drop any row that wasn't mapped successfully\n",
        "df_vader_clean = df_vader.dropna(subset=['actual_sentiment_mapped']).copy()\n",
        "\n",
        "y_true_vader = df_vader_clean['actual_sentiment_mapped']\n",
        "y_pred_vader = df_vader_clean['vader_sentiment']\n",
        "\n",
        "# Define target classes order\n",
        "classes = ['NEGATIVE', 'NEUTRAL', 'POSITIVE']\n",
        "cm_vader = confusion_matrix(y_true_vader, y_pred_vader, labels=classes)\n",
        "\n",
        "# Plot the Confusion Matrix\n",
        "plt.figure(figsize=(8, 6))\n",
        "sns.heatmap(cm_vader, annot=True, fmt='d', cmap='Purples', xticklabels=classes, yticklabels=classes)\n",
        "plt.title('Confusion Matrix (Actual Sentiment vs VADER Sentiment)')\n",
        "plt.ylabel('Actual Mapped Sentiment')\n",
        "plt.xlabel('VADER Predicted Sentiment')\n",
        "plt.show()\n",
        "\n",
        "# Display Classification Report\n",
        "print(\"VADER Classification Report:\\n\")\n",
        "print(classification_report(y_true_vader, y_pred_vader, labels=classes))"
      ],
