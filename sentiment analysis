        "# 2. Import core libraries\n",
        "import os\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from transformers import pipeline\n",
        "from vaderSentiment.vaderSentiment import SentimentIntensityAnalyzer\n",
        "from sklearn.metrics import confusion_matrix, classification_report"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "1c0554c0"
      },
      "outputs": [],
      "source": [
        "# 3. Load the original dataset\n",
        "df = pd.read_csv(\"sentiment.csv.csv\")\n",
        "display(df.head())"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "ff384a57"
      },
      "outputs": [],
      "source": [
        "# 4. Set up the Transformer Sentiment Analysis Pipeline\n",
        "analyzer = pipeline(\"sentiment-analysis\", model=\"distilbert/distilbert-base-uncased-finetuned-sst-2-english\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "6ec90d42"
      },
      "outputs": [],
      "source": [
        "# 5. Apply the Transformer pipeline to the text column\n",
        "df[\"sentiment\"] = df[\"text\"].fillna(\"\").astype(str).apply(\n",
        "    lambda text: analyzer(text[:512])[0][\"label\"] if text.strip() else \"\"\n",
        ")\n",
        "\n",
        "# Save the intermediate pipeline results\n",
        "df.to_csv(\"sentiment_results.csv\", index=False)\n",
        "display(df[[\"text\", \"sentiment\"]].head())"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "8adc03bc"
      },
      "outputs": [],
      "source": [
        "# 6. Visualize the Transformer prediction distribution\n",
        "sentiment_counts = df['sentiment'].value_counts()\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.barplot(x=sentiment_counts.index, y=sentiment_counts.values, palette='viridis', hue=sentiment_counts.index, legend=False)\n",
        "\n",
        "plt.title('Distribution of Transformer Sentiment Labels', fontsize=16)\n",
        "plt.xlabel('Sentiment Label', fontsize=12)\n",
        "plt.ylabel('Count', fontsize=12)\n",
        "plt.xticks(rotation=45, ha='right')\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "d3f4b80d"
      },
      "outputs": [],
      "source": [
        "# 7. Prepare ground truth emotions for performance evaluation\n",
        "# Rename sentiment column to 'actual_emotion' to keep raw data clean\n",
        "df_orig = pd.read_csv(\"sentiment.csv.csv\").rename(columns={'sentiment': 'actual_emotion'})\n",
        "\n",
        "emotion_map = {\n",
        "    'sadness': 'NEGATIVE',\n",
        "    'anger': 'NEGATIVE',\n",
        "    'fear': 'NEGATIVE',\n",
        "    'disgust': 'NEGATIVE',\n",
        "    'shame': 'NEGATIVE',\n",
        "    'guilt': 'NEGATIVE',\n",
        "    'joy': 'POSITIVE',\n",
        "    'love': 'POSITIVE',\n",
        "    'surprise': 'POSITIVE',\n",
        "    'neutral': 'NEGATIVE'\n",
        "}\n",
        "\n",
        "df_orig['actual_sentiment'] = df_orig['actual_emotion'].str.lower().str.strip().map(emotion_map)\n",
        "df_clean = df_orig.dropna(subset=['actual_sentiment']).copy()\n",
        "display(df_clean.head())"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "b2a1239f"
      },
      "outputs": [],
      "source": [
        "# 8. Run predictions on mapped evaluation dataset\n",
        "df_clean[\"predicted_sentiment\"] = df_clean[\"text\"].fillna(\"\").astype(str).apply(\n",
        "    lambda text: analyzer(text[:512])[0][\"label\"] if text.strip() else \"\"\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "e868e67a"
      },
      "outputs": [],
      "source": [
        "# 9. Generate and plot Confusion Matrix and Classification Report\n",
        "y_true = df_clean['actual_sentiment']\n",
        "y_pred = df_clean['predicted_sentiment']\n",
        "\n",
        "labels = sorted(list(set(y_true).union(set(y_pred))))\n",
        "cm = confusion_matrix(y_true, y_pred, labels=labels)\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=labels, yticklabels=labels)\n",
        "plt.title('Confusion Matrix (Actual Emotion Sentiment vs Predicted Sentiment)')\n",
        "plt.ylabel('Actual Sentiment (Mapped)')\n",
        "plt.xlabel('Predicted Sentiment')\n",
        "plt.show()\n",
        "\n",
        "print(\"\\nClassification Report:\\n\")\n",
        "print(classification_report(y_true, y_pred, labels=labels))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "e2a7c60c"
      },
      "outputs": [],
      "source": [
        "# 10. Run VADER Sentiment Analyzer\n",
        "vader_analyzer = SentimentIntensityAnalyzer()\n",
        "\n",
        "def get_vader_sentiment(text):\n",
        "    if not isinstance(text, str) or not text.strip():\n",
        "        return 'NEUTRAL'\n",
        "    score = vader_analyzer.polarity_scores(text)['compound']\n",
        "    if score >= 0.05:\n",
        "        return 'POSITIVE'\n",
        "    elif score <= -0.05:\n",
        "        return 'NEGATIVE'\n",
        "    else:\n",
        "        return 'NEUTRAL'\n",
        "\n",
        "df_vader = pd.read_csv('sentiment.csv.csv')\n",
        "print(\"Analyzing sentiment with VADER...\")\n",
        "df_vader['vader_sentiment'] = df_vader['text'].apply(get_vader_sentiment)\n",
        "display(df_vader[['text', 'sentiment', 'vader_sentiment']].head(10))"
      ]
    },
