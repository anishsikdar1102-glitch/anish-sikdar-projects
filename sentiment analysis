        "# Install vaderSentiment if not already installed\n",
        "import sys\n",
        "try:\n",
        "    from vaderSentiment.vaderSentiment import SentimentIntensityAnalyzer\n",
        "except ModuleNotFoundError:\n",
        "    print(\"vaderSentiment not found. Installing now...\")\n",
        "    !{sys.executable} -m pip install -q vaderSentiment\n",
        "    from vaderSentiment.vaderSentiment import SentimentIntensityAnalyzer\n",
        "\n",
        "import os\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# List files in the current directory to help debug\n",
        "current_files = os.listdir('.')\n",
        "print(\"Files in current directory:\", current_files)\n",
        "\n",
        "# Automatically find any CSV file to use as fallback if the expected ones aren't found\n",
        "possible_files = ['sentiment.csv.csv', 'sentiment.csv', 'sentiment_results.csv']\n",
        "selected_file = None\n",
        "\n",
        "for f in possible_files:\n",
        "    if os.path.exists(f):\n",
        "        selected_file = f\n",
        "        break\n",
        "\n",
        "if selected_file is None:\n",
        "    csv_files = [f for f in current_files if f.endswith('.csv')]\n",
        "    if csv_files:\n",
        "        selected_file = csv_files[0]\n",
        "        print(f\"Expected files not found. Auto-selecting alternative CSV: {selected_file}\")\n",
        "\n",
        "if selected_file is None:\n",
        "    raise FileNotFoundError(f\"Could not find any of the dataset files. Please upload your sentiment dataset. Available files: {current_files}\")\n",
        "\n",
        "print(f\"Loading dataset from: {selected_file}\")\n",
        "df_vader = pd.read_csv(selected_file)\n",
        "\n",
        "# Initialize VADER sentiment analyzer\n",
        "analyzer = SentimentIntensityAnalyzer()\n",
        "\n",
        "# Function to categorize compound score\n",
        "def get_vader_sentiment(text):\n",
        "    if not isinstance(text, str) or not text.strip():\n",
        "        return 'NEUTRAL'\n",
        "    score = analyzer.polarity_scores(text)['compound']\n",
        "    if score >= 0.05:\n",
        "        return 'POSITIVE'\n",
        "    elif score <= -0.05:\n",
        "        return 'NEGATIVE'\n",
        "    else:\n",
        "        return 'NEUTRAL'\n",
        "\n",
        "# Apply sentiment analysis\n",
        "print(\"Analyzing sentiment with VADER...\")\n",
        "df_vader['vader_sentiment'] = df_vader['text'].apply(get_vader_sentiment)\n",
        "\n",
        "# Display sample results\n",
        "display(df_vader[['text', 'vader_sentiment']].head(10))\n",
        "\n",
        "# Plot distribution of VADER sentiment labels\n",
        "plt.figure(figsize=(8, 5))\n",
        "sns.countplot(data=df_vader, x='vader_sentiment', palette='viridis', hue='vader_sentiment', legend=False)\n",
        "plt.title('VADER Sentiment Distribution')\n",
        "plt.xlabel('Sentiment Class')\n",
        "plt.ylabel('Count')\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "plt.show()"
      ]
