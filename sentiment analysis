      "source": [
        "import os\n",
        "import pandas as pd\n",
        "from sklearn.metrics import confusion_matrix, classification_report\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "from transformers import pipeline\n",
        "\n",
        "# 1. Reload the original dataset to preserve both text and original ground truth emotion\n",
        "df_orig = pd.read_csv(\"sentiment.csv.csv\")\n",
        "# Rename the original 'sentiment' column to 'actual_emotion' to avoid overwriting it\n",
        "df_orig = df_orig.rename(columns={'sentiment': 'actual_emotion'})\n",
        "\n",
        "# 2. Map multi-class emotions to binary POSITIVE/NEGATIVE to align with the default sentiment model\n",
        "# (Assuming sadness, anger, fear, disgust, etc., are NEGATIVE, and joy/happy/surprise are POSITIVE)\n",
        "emotion_map = {\n",
        "    'sadness': 'NEGATIVE',\n",
        "    'anger': 'NEGATIVE',\n",
        "    'fear': 'NEGATIVE',\n",
        "    'disgust': 'NEGATIVE',\n",
        "    'shame': 'NEGATIVE',\n",
        "    'guilt': 'NEGATIVE',\n",
        "    'joy': 'POSITIVE',\n",
        "    'love': 'POSITIVE',\n",
        "    'surprise': 'POSITIVE',\n",
        "    'neutral': 'NEGATIVE' # Neutral can be mapped to negative or skipped; mapping to negative here for binary alignment\n",
        "}\n",
        "\n",
        "df_orig['actual_sentiment'] = df_orig['actual_emotion'].str.lower().str.strip().map(emotion_map)\n",
        "\n",
        "# Filter out any unmapped rows (like neutral, if we want a strict binary classification comparison)\n",
        "df_clean = df_orig.dropna(subset=['actual_sentiment']).copy()\n",
        "\n",
        "# 3. Generate predictions using the sentiment analyzer pipeline\n",
        "print(\"Running sentiment analysis pipeline on the dataset...\")\n",
        "analyzer = pipeline(\"sentiment-analysis\", model=\"distilbert/distilbert-base-uncased-finetuned-sst-2-english\")\n",
        "\n",
        "df_clean[\"predicted_sentiment\"] = df_clean[\"text\"].fillna(\"\").astype(str).apply(\n",
        "    lambda text: analyzer(text[:512])[0][\"label\"] if text.strip() else \"\"\n",
        ")\n",
        "\n",
        "# 4. Generate and plot the Confusion Matrix\n",
        "y_true = df_clean['actual_sentiment']\n",
        "y_pred = df_clean['predicted_sentiment']\n",
        "\n",
        "labels = sorted(list(set(y_true).union(set(y_pred))))\n",
        "cm = confusion_matrix(y_true, y_pred, labels=labels)\n",
        "\n",
        "# Plot\n",
        "plt.figure(figsize=(8, 6))\n",
        "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=labels, yticklabels=labels)\n",
        "plt.title('Confusion Matrix (Actual Emotion Sentiment vs Predicted Sentiment)')\n",
        "plt.ylabel('Actual Sentiment (Mapped)')\n",
        "plt.xlabel('Predicted Sentiment')\n",
        "plt.show()\n",
        "\n",
        "# Classification Report\n",
        "print(\"\\nClassification Report:\\n\")\n",
        "print(classification_report(y_true, y_pred, labels=labels))"
      ]
